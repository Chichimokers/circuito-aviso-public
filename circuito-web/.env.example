# ===========================================================================
# Circuito Aviso - Backend web (.env)
# Copia este archivo a `.env` (dentro de `circuito-web/`) y rellena tus valores.
# ===========================================================================

# Puerto de escucha de Uvicorn (detras de nginx)
PORT=8781

# Clave para las operaciones protegidas (borrar marcadores, etc.)
ADMIN_KEY=cambia_esta_clave

# --- Web Push (VAPID) ---
# Genera el par de claves con: `python -m py_vapid --gen` o el script oficial
# de pywebpush. La publica se expone al frontend; la privada solo al backend.
VAPID_SUBJECT=mailto:tu_correo@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
