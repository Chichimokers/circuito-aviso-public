# ===========================================================================
# Circuito Aviso - Monitor de Telegram (.env)
# Copia este archivo a `.env` y rellena tus propios valores.
# NUNCA subas el `.env` real al repositorio (ya esta en .gitignore).
# ===========================================================================

# --- API de Telegram (https://my.telegram.org) ---
# Credenciales de la aplicacion. El userbot las usa para escuchar los grupos.
API_ID=123456
API_HASH=tu_api_hash
PHONE=+5355555555
SESSION_NAME=circuito_monitor

# --- Bot de alertas (crate un bot con @BotFather) ---
BOT_TOKEN=123456:ABC-DEF...

# --- Grupos a monitorear (IDs separados por coma) ---
WATCH_GROUPS=-1001234567890,-1009876543210

# --- Grupo/canal destino donde el bot publica las alertas ---
ALERT_GROUP=-1001234567890

# --- Canales OFICIALES (username sin @, separados por coma) ---
# Sus posts generan notificaciones normales y ademas fijan el color
# persistente (verde/rojo) de los circuitos.
OFFICIAL_CHANNELS=

# --- Municipios a detectar por nombre (separados por coma) ---
WATCH_MUNICIPALITIES=Boyeros,Cenpalab

# --- Codigos que disparan tagueo especial (separados por coma) ---
TAG_CIRCUITS=M2044,D1190,A1496
SPECIAL_TAG=

# --- Backend web (API de circuitos + registro de eventos) ---
WEB_API=http://127.0.0.1:8781
CODES_REFRESH=60
